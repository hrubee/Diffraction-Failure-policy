<?xml version="1.0"?>
<robot name="agilex_hunter_se">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <mass value="65.0"/>
      <inertia ixx="1.85" ixy="0.0" ixz="0.0" iyy="2.45" iyz="0.0" izz="3.10"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.82 0.64 0.28"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.18 0.64 0.84 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.82 0.64 0.28"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.024" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.024"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <material name="tire_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.32 0.28 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="45.0" velocity="22.0"/>
    <dynamics damping="0.8" friction="0.15"/>
  </joint>

  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.024" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.024"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <material name="tire_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.32 -0.28 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="45.0" velocity="22.0"/>
    <dynamics damping="0.8" friction="0.15"/>
  </joint>

  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.024" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.024"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.32 0.28 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="45.0" velocity="22.0"/>
    <dynamics damping="0.8" friction="0.15"/>
  </joint>

  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.024" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.024"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.32 -0.28 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="45.0" velocity="22.0"/>
    <dynamics damping="0.8" friction="0.15"/>
  </joint>
</robot>
