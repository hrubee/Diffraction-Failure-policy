[Unit]
Description=Diffraction Physical AI Ingestion Gateway & Web Console
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/diffraction
ExecStart=/opt/diffraction/venv/bin/python3 cli.py serve --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
